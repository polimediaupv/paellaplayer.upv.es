---
const { id, manifestId } = Astro.props;
import "@asicupv/paella-core/paella-core.css";
import "@asicupv/paella-basic-plugins/paella-basic-plugins.css";
import "@asicupv/paella-slide-plugins/paella-slide-plugins.css";
import "@asicupv/paella-zoom-plugin/paella-zoom-plugin.css";
---

<article>
    <div class="player-container not-content" id={id}></div>
</article>

<player-data data-id={id} data-manifest-id={manifestId}></player-data>

<script>
    // @ts-nocheck
    import { Paella } from "@asicupv/paella-core";
    import { basicPlugins } from "@asicupv/paella-basic-plugins";
    import { slidePlugins } from "@asicupv/paella-slide-plugins";
    import {
        HlsVideoFormatPlugin,
        HlsLiveVideoFormatPlugin,
        HlsCaptionsSelectorButtonPlugin,
        Mp4MultiQualityVideoFormatPlugin
    } from '@asicupv/paella-video-plugins';
    import {
        ZoomCanvasPlugin,
        CanvasZoomInButtonPlugin,
        CanvasZoomOutButtonPlugin,
        ZoomInButtonPlugin,
        ZoomOutButtonPlugin,
        ZoomMenuButtonPlugin
    } from "@asicupv/paella-zoom-plugin";
    import {
        
    } from "@asicupv/paella-webgl-plugins";

    async function loadPlayer(containerId: string, manifest?: string) {

        const player = new Paella(containerId, {
            plugins: [
                ...basicPlugins,
                ...slidePlugins,
                {
                    plugin: HlsVideoFormatPlugin,
                    config: {
                        enabled: true,
                        priority: 0
                    }
                },
                HlsLiveVideoFormatPlugin,
                HlsCaptionsSelectorButtonPlugin,
                Mp4MultiQualityVideoFormatPlugin,
                ZoomCanvasPlugin,
                CanvasZoomInButtonPlugin,
                CanvasZoomOutButtonPlugin,
                ZoomInButtonPlugin,
                ZoomOutButtonPlugin,
                ZoomMenuButtonPlugin
            ],

            configResourcesUrl: '/player-config/',
            configUrl: '/player-config/config.json',
            defaultVideoPreview: '/player-config/default_preview_landscape.jpg',
            

            getVideoId: (config: any, player: Paella) => {
                return manifest;
            }
        });

        await player.skin.loadSkin("/skin/skin_1.json");
        
        await player.loadManifest();

        let nativePlayer = null;
        if (player.streams.isNativelyPlayable && player.streams.isAudioOnly) {
            nativePlayer = player.streams.nativePlayer;
            nativePlayer.setAttribute("controls", "true");
            const container = document.getElementById(containerId);
            if (container) {
                container.innerHTML = "";
                container.appendChild(nativePlayer);
                container.classList.add("native-player");
                player.unload();
            }
        }
    }

    class PlayerLoader extends HTMLElement {
        connectedCallback() {
            const id = this.dataset.id;
            const manifestId = this.dataset.manifestId;
            console.log(this.dataset);
            
            loadPlayer(id ?? "", manifestId ?? "")
                .then(() => {
                    console.log("Player loaded successfully");
                })
                .catch((error) => {
                    console.error("Error loading player:", error);
                });
        }
    }
    
    customElements.define("player-data", PlayerLoader);
</script>

<style is:global>
    :root {
        --highlight-bg-color: #e0ab1b;
        --highlight-bg-color-hover: #624802;
    }

    .native-player {
        width: 100%;

        & > audio,video {
            width: 100%;
        }
    }
</style>
<style>
    .player-container {
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        aspect-ratio: 16/9;
    }

    @media (max-width: 600px) {
        .player-container {
            aspect-ratio: calc(100vw / 80vh);
        }
    }

    :root {
        --progress-indicator-padding: 6px 15px;
        --playback-bar-buttons-padding: 5px 10px;
        --button-fixed-size: 30px;
        --canvas-button-container-padding: 6px 2.2%;
    }
</style>
