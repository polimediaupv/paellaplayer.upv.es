---
import Player from "@/components/Player.astro";
type PlayerExampleProps = {
  title: string;
  description: string;
  manifest: string;
  id: string;
};
const { title, description, manifest, id } = Astro.props;
---
<article>
    <header>
        <h3>{title}</h3>
        <p>{description}</p>
    </header>
    <section>
        <Player id={id} manifestId={manifest} />
    </section>
</article>

<style>
    article {
        display: flex;
        flex-direction: column;
        margin: 5ch 0;

        & > section {
            aspect-ratio: 16/9;
        }
    }
</style>