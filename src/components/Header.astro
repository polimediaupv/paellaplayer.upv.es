---
import lightLogo from "@/assets/light-logo.webp";
import darkLogo from "@/assets/dark-logo.webp";
import ThemeChooser from "@/components/ThemeChooser.astro";
const currentPath = Astro.url.pathname;
---

<header class="navbar bg-base-100 shadow-sm">
    <div class="flex-1">
        <a class="btn btn-ghost text-xl" href="/">
            <img class="h-10 header-logo-dark" src={darkLogo.src} alt="Logo" />
            <img class="h-10 header-logo-light" src={lightLogo.src} alt="Logo" />
        </a>
    </div>
    <nav class="flex-none">
        <menu class="menu menu-horizontal px-1">
            <li><a href="/examples" class={/examples/i.test(currentPath) ? "active" : ""}>Examples</a></li>
            <li><a href="/documentation" class={/documentation/i.test(currentPath) ? "active" : ""}>Documentation</a></li>
        </menu>
    </nav>
    <ThemeChooser class="flex-none" />
</header>
