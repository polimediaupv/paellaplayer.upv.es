---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

// Import any other components you want to use in your custom page.
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import PlayerExample from '@/components/PlayerExample.astro'
import examples from '@/data/examples.json'
---

<StarlightPage frontmatter={{ title: 'My custom page', template: "splash" }}>
    <p>This is a custom page with a custom component:</p>

    <AnchorHeading level="2" id="learn-more">Demos</AnchorHeading>
    {examples.map(example => (
        <PlayerExample
            title={example.title}
            description={example.description}
            manifest={example.manifest}
            id={example.title.replace(/\s+/g, '-').toLowerCase()}
        />
    ))} 
</StarlightPage>


