<style>
    svg {
        width: 100%;
    }
    
    .fill {
        stroke: none;
    }

    .fill.primary {
        fill: var(--color-main);
    }

    .fill.light {
        fill: var(--color-light);
    }

    .fill.dark {
        fill: var(--color-dark);
    }

    .stroke {
        fill: none;
    }

    .stroke.primary {
        stroke: var(--color-main);
    }

    .stroke.light {
        stroke: var(--color-light);
    }

    .stroke.dark {
        stroke: var(--color-dark);
    }
</style>