---
import "@fontsource-variable/fredoka";
import "@fontsource-variable/lexend";
import Header from "@/components/Header.astro"
import UpvLogo from "@/assets/upvlogo.png";

const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
</head>
<body>
    <Header></Header>
    <main>
        <slot/>
    </main>
    <footer>
        Supported by:
        <img src={UpvLogo.src} alt="upv logo" />
    </footer>
</body>
</html>

<style is:global={true}>

    :root {
        --color-dark: #343434;
        --color-darker: #262626;
        --color-darkest: #1d1d1d;
        --color-mid: #5c5c5c;
        --color-light: #e7e7e7;
        --color-lighter: #f3f3f3;
        --color-lightest: #f5f5f5;
        --color-main: #e0ab1b;
        --color-secondary: #624802;
        --color-main-comp: #00a310;
        --color-secondary-comp: #01860a;
    }

    body {
        font-family: "Lexend Variable", sans-serif;
        margin: 0;
        display: grid;
        grid-template-columns: 1fr;
        grid-template-rows: 80px 1fr 70px;
        grid-template-areas:
            "header"
            "main"
            "footer";
        justify-items: center;
        background: var(--color-light);

        & > header {
            grid-area: header;
            box-sizing: border-box;
            width: 100vw;
        }

        & > main {
            grid-area: main;
            width: 90vw;
            max-width: 1200px;
            min-height: 90vh;
            background-color: white;
            box-sizing: border-box;
            padding: 1ch 4ch;
        }

        & > footer {
            grid-area: footer;
            background-color: white;
            width: 90vw;
            max-width: 1200px;
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 2ch;
            padding: 2ch;
            box-sizing: border-box;
            border-top: 3px solid var(--color-main);

            & > img {
                height: 3ch;
                margin-left: 1ch;
            }
        }
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: "Fredoka Variable", sans-serif;
        margin: 1ch 0 0.4ch 0;
    }

    h1 {
        font-size: 2em;
    }

    h2 {
        font-size: 1.5em;
    }

    h3, h4, h5, h6 {
        font-size: 1em;
    }

    @media (max-width: 850px) {
        body > main {
            width: 100vw;
        }
    }
</style>